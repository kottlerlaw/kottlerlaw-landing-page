# Microsoft 365 (Outlook) account used to send contact-form emails, through the Microsoft Graph API.
# Register an app in Microsoft Entra with the Mail.Send application permission (admin consent),
# limited to the sending mailbox. See README.md.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Mailbox the emails are sent from, e.g. website@kottlerlaw.com
MAIL_FROM=
# Inbox that receives inquiries (defaults to MAIL_FROM)
CONTACT_TO=
